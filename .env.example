# Affiliate loan application (POST /affiliates/lead). Overrides default `${VITE_BACKEND_BASE_URL}/affiliates/lead`.
# VITE_AFFILIATE_LEAD_URL=https://your-api.example.com/affiliates/lead
# VITE_AFFILIATE_API_ID=loantubedirect
# VITE_AFFILIATE_API_PASSWORD=

# Offer page: expandable "Support reference" — shown unless you set this to false at build time.
# VITE_SHOW_OFFER_SUPPORT_REFERENCE=false

# Microsoft Clarity (session replay, heatmaps). Get your Project ID from https://clarity.microsoft.com
# VITE_CLARITY_PROJECT_ID=your_project_id

# Sentry (error monitoring). Get your DSN from https://sentry.io
# VITE_SENTRY_DSN=https://key@o123456.ingest.us.sentry.io/1234567
